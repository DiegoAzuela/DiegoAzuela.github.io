---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site.ts';
import { summary, experience, research, education, skills } from '../data/cv.ts';
---

<Base bareFooter>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="hero__inner">
      <p class="hero__eyebrow">{site.role}</p>
      <h1 class="hero__name">{site.name}</h1>
      <p class="hero__domains">
        {
          site.domains.map((d, i) => (
            <>
              {i > 0 && <span class="hero__sep">·</span>}
              <a href={d.href} class="link-underline">{d.label}</a>
            </>
          ))
        }
      </p>
    </div>
    <a href="#cv" class="hero__scroll" aria-label="Scroll to CV">
      <Icon name="arrow-down" size={18} />
    </a>
  </section>

  <!-- ================= CV ================= -->
  <div class="container cv" id="cv">
    <header class="cv__head" data-reveal>
      <p class="eyebrow">Curriculum vitae</p>
      <h2>{site.fullName}</h2>
      <p class="prose cv__summary">{summary}</p>
      <p class="cv__actions">
        <a href="/cv" class="link-underline">Full CV page</a>
        <span class="hero__sep">·</span>
        <a href="/cv/Diego-Azuela-CV.pdf" class="link-underline">Download PDF</a>
      </p>
    </header>

    <section class="cv__block" data-reveal>
      <h3 class="cv__block-title">Experience</h3>
      {
        experience.map((r) => (
          <article class="entry">
            <div class="entry__meta">
              <p class="entry__period">{r.period}</p>
              <p class="entry__loc">{r.location}</p>
            </div>
            <div class="entry__body">
              <h4>
                {r.title} <span>· {r.org}</span>
              </h4>
              {r.group && <p class="entry__group">{r.group}</p>}
              <ul>
                {r.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </section>

    <section class="cv__block" data-reveal>
      <h3 class="cv__block-title">Research</h3>
      {
        research.map((r) => (
          <article class="entry">
            <div class="entry__meta">
              <p class="entry__period">{r.period}</p>
              <p class="entry__loc">{r.location}</p>
            </div>
            <div class="entry__body">
              <h4>
                {r.title} <span>· {r.org}</span>
              </h4>
              <ul>
                {r.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
      <p class="cv__more">
        <a href="/research" class="link-underline">Publications &amp; talks →</a>
      </p>
    </section>

    <section class="cv__block" data-reveal>
      <h3 class="cv__block-title">Education</h3>
      {
        education.map((e) => (
          <article class="entry">
            <div class="entry__meta">
              <p class="entry__period">{e.period}</p>
            </div>
            <div class="entry__body">
              <h4>
                {e.degree} <span>· {e.org}</span>
              </h4>
              <p class="entry__group">{e.detail}</p>
            </div>
          </article>
        ))
      }
    </section>

    <section class="cv__block" data-reveal>
      <h3 class="cv__block-title">Technical skills</h3>
      <dl class="skills">
        {
          skills.map((s) => (
            <div class="skills__row">
              <dt>{s.group}</dt>
              <dd>{s.items}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>

  <Footer />
</Base>

<style>
  /* ---------- HERO: recreates the two-rule + name reveal ---------- */
  .hero {
    position: relative;
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 6rem 1.5rem 4rem;
    overflow: hidden;
  }
  .hero__inner {
    text-align: center;
    max-width: 40rem;
  }
  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-muted);
    opacity: 0;
    animation: fade-up 0.8s var(--ease) 0.9s forwards;
  }
  .hero__name {
    position: relative;
    font-size: var(--step-4);
    font-weight: 600;
    letter-spacing: -0.03em;
    margin: 1.4rem 0;
    padding: 1.4rem 0;
    opacity: 0.001;
    transform: scale(0.94);
    animation: hero-name 0.9s var(--ease) 0.2s forwards;
  }
  /* the animated horizontal rules */
  .hero__name::before,
  .hero__name::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 0;
    height: 1px;
    background: var(--line-strong);
    transform: translateX(-50%);
    animation: rule-draw 0.85s var(--ease) 0.55s forwards;
  }
  .hero__name::before { top: 0; }
  .hero__name::after { bottom: 0; }

  .hero__domains {
    font-size: var(--step-1);
    color: var(--text-dim);
    opacity: 0;
    animation: fade-up 0.8s var(--ease) 1s forwards;
  }
  .hero__sep { color: var(--text-muted); margin-inline: 0.6rem; }

  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--text-muted);
    opacity: 0;
    animation: fade-up 1s var(--ease) 1.4s forwards;
  }
  .hero__scroll:hover { color: var(--accent); }

  @keyframes hero-name {
    to { opacity: 1; transform: none; }
  }
  @keyframes rule-draw {
    to { width: min(22rem, 70vw); }
  }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__eyebrow, .hero__name, .hero__domains, .hero__scroll {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
    .hero__name::before, .hero__name::after {
      width: min(22rem, 70vw);
      animation: none;
    }
  }

  /* ---------- CV ---------- */
  .cv { padding-block: clamp(4rem, 9vw, 7rem); }
  .cv__head { max-width: 52rem; margin-bottom: clamp(3rem, 7vw, 5rem); }
  .cv__head h2 { font-size: var(--step-3); margin: 0.6rem 0 1.4rem; }
  .cv__summary { color: var(--text-dim); }
  .cv__actions {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .cv__block { padding-block: clamp(2rem, 5vw, 3.25rem); border-top: 1px solid var(--line); }
  .cv__block-title {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .entry {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 2rem;
    padding-block: 1.5rem;
  }
  .entry + .entry { border-top: 1px solid var(--line); }
  .entry__meta { font-family: var(--font-mono); font-size: var(--step--1); color: var(--text-muted); }
  .entry__loc { margin-top: 0.2rem; }
  .entry__body h4 { font-size: var(--step-1); font-weight: 600; }
  .entry__body h4 span { color: var(--text-muted); font-weight: 400; }
  .entry__group {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-muted);
    margin-top: 0.35rem;
  }
  .entry__body ul {
    margin-top: 1rem;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.7rem;
    color: var(--text-dim);
  }
  .entry__body li { padding-left: 0.3rem; }
  .entry__body li::marker { color: var(--accent); }

  .cv__more { margin-top: 1.5rem; font-family: var(--font-mono); font-size: var(--step--1); }

  .skills__row {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 2rem;
    padding-block: 1rem;
  }
  .skills__row + .skills__row { border-top: 1px solid var(--line); }
  .skills dt { font-weight: 500; }
  .skills dd { color: var(--text-dim); }

  @media (max-width: 720px) {
    .entry, .skills__row { grid-template-columns: 1fr; gap: 0.6rem; }
    .entry__meta { display: flex; gap: 1rem; }
    .entry__loc { margin-top: 0; }
  }
</style>
