---
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Icon from '../../../components/Icon.astro';
import { museums } from '../../../data/museums.ts';

export function getStaticPaths() {
  return museums.map((m) => ({ params: { slug: m.slug }, props: { museum: m } }));
}

const { museum } = Astro.props;
---

<Base title={museum.name} description={`${museum.name}, ${museum.city}`}>
  <PageHeader
    eyebrow={museum.city}
    title={museum.name}
    back={{ href: '/interests/museums', label: 'Museums & places' }}
  />

  <div class="container museum">
    <figure class="museum__photo" data-reveal>
      <img src={museum.image} alt={`${museum.name} — my visit`} />
      {museum.caption && <figcaption>{museum.caption}</figcaption>}
    </figure>

    <section class="museum__pieces" data-reveal>
      <h2 class="museum__label">Pieces I keep thinking about</h2>
      {
        museum.pieces.length > 0 ? (
          <ul class="pieces">
            {museum.pieces.map((p) => (
              <li class="piece">
                <span class="piece__title">{p.title}</span>
                <span class="piece__artist">{p.artist}</span>
                {p.note && <span class="piece__note">{p.note}</span>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="museum__empty">
            My picks from here are still being written up. In the meantime,
            {museum.website ? (
              <>
                {' '}
                <a href={museum.website} target="_blank" rel="noopener" class="link-underline">
                  browse the collection
                </a>
                .
              </>
            ) : (
              ' check back soon.'
            )}
          </p>
        )
      }
      {
        museum.website && museum.pieces.length > 0 && (
          <p class="museum__link">
            <a href={museum.website} target="_blank" rel="noopener" class="link-underline">
              Museum collection <Icon name="arrow-up-right" size={13} />
            </a>
          </p>
        )
      }
    </section>
  </div>
</Base>

<style>
  .museum { padding-block: clamp(2.25rem, 5vw, 3.25rem) clamp(4rem, 9vw, 7rem); display: grid; gap: clamp(2.5rem, 6vw, 4rem); }
  .museum__photo img { width: 100%; max-height: 70vh; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--line); }
  .museum__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  .pieces { list-style: none; padding: 0; display: grid; gap: 0; }
  .piece {
    display: grid;
    gap: 0.2rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--line);
  }
  .piece:last-child { border-bottom: 1px solid var(--line); }
  .piece__title { font-size: var(--step-1); font-weight: 600; }
  .piece__artist { color: var(--text-muted); font-family: var(--font-mono); font-size: var(--step--1); }
  .piece__note { color: var(--text-dim); margin-top: 0.4rem; max-width: var(--measure); }
  .museum__empty { color: var(--text-dim); max-width: var(--measure); }
  .museum__link { margin-top: 1.5rem; font-family: var(--font-mono); font-size: var(--step--1); }
  .museum__link a { display: inline-flex; align-items: center; gap: 0.3rem; }
</style>
