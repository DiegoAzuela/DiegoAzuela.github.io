---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CvBody from '../components/CvBody.astro';
import { site } from '../data/site.ts';
import { summary } from '../data/cv.ts';
---

<Base title="Curriculum Vitae" description={summary}>
  <PageHeader
    eyebrow="Curriculum vitae"
    title={site.fullName}
    intro={summary}
  />
  <div class="container cv-page">
    <p class="cv-page__actions" data-reveal>
      <a href="/cv/Diego-Azuela-CV.pdf" class="link-underline">Download PDF</a>
      <span class="sep">·</span>
      <a href={`mailto:${site.email}`} class="link-underline">Email me</a>
    </p>
    <CvBody />
  </div>
</Base>

<style>
  .cv-page { padding-block: clamp(2.5rem, 6vw, 4rem); }
  .cv-page__actions {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    margin-bottom: 1rem;
  }
  .sep { color: var(--text-muted); margin-inline: 0.6rem; }
</style>
