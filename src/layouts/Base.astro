---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.ts';

interface Props {
  title?: string;
  description?: string;
  /** hide the global footer (used on the home page) */
  bareFooter?: boolean;
}
const { title, description = site.description, bareFooter = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/fonts/Geist-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Geist-SemiBold.woff2" as="font" type="font/woff2" crossorigin />

    <!-- webscrape disclaimer, per your easter_egg note -->
    <meta name="robots" content="noai, noimageai" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteNav />
    <main id="main">
      <slot />
    </main>
    {!bareFooter && <Footer />}

    <script>
      // Quiet scroll-reveal (skill: IntersectionObserver, never scroll listener)
      const els = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
